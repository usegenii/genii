{
	"name": "@genii/orchestrator",
	"version": "1.0.0",
	"description": "Core orchestrator system for managing autonomous AI agents",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"./*": {
			"import": "./dist/*.js",
			"types": "./dist/*.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup && tsc --emitDeclarationOnly -p tsconfig.build.json",
		"dev": "tsup --watch",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"ai",
		"agents",
		"orchestrator"
	],
	"author": "",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/usegenii/genii"
	},
	"packageManager": "pnpm@11.22.0",
	"dependencies": {
		"@mariozechner/pi-agent-core": "0.73.1",
		"@mariozechner/pi-ai": "0.73.1",
		"@sinclair/typebox": "0.34.52",
		"chrono-node": "2.10.1"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"tsup": "8.5.1",
		"typescript": "7.0.2",
		"vitest": "3.2.7"
	}
}
