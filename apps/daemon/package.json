{
	"name": "@genii/daemon",
	"version": "1.0.0",
	"description": "Background daemon for managing AI agents and communication channels",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"genii-daemon": "./dist/daemon.js"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./daemon": "./dist/daemon.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsx watch src/index.ts",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"daemon",
		"ai",
		"agents"
	],
	"author": "",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/usegenii/genii"
	},
	"packageManager": "pnpm@11.21.0",
	"dependencies": {
		"@genii/comms": "workspace:*",
		"@genii/config": "workspace:*",
		"@genii/guidance": "workspace:*",
		"@genii/lib": "workspace:*",
		"@genii/models": "workspace:*",
		"@genii/orchestrator": "workspace:*",
		"croner": "9.1.0",
		"pino": "10.3.1",
		"pino-pretty": "13.1.3",
		"pino-roll": "4.0.0"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"tsup": "8.5.1",
		"typescript": "7.0.2",
		"vitest": "3.2.7"
	}
}
